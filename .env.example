# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/signalguard

# Session Configuration (optional - system will use defaults)
# SESSION_EXPIRY_HOURS=24

# Upload Configuration (optional)
# UPLOAD_DIR=./uploads
# MAX_UPLOAD_SIZE_MB=500

# AI Model Configuration (optional - for future use)
# MODEL_PATH=./models
# YOLO_MODEL=yolov8n.pt
# CONFIDENCE_THRESHOLD=0.7
# PROCESSING_FPS=10

# Node Environment
NODE_ENV=production
